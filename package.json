{
    "name": "@un/tool-project",
    "private": true,
    "packageManager": "pnpm@10.32.1",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "start": "turbo run start --parallel",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "test": "turbo run test",
        "release": "changeset publish",
        "rebuild": "electron-rebuild",
        "prisma:clean": "npx prisma clean",
        "prisma:gen": "npx prisma generate",
        "prisma:pull": "npx prisma db pull"
    },
    "devDependencies": {
        "node-abi": "^4.28.0",
        "prettier": "^3.8.1",
        "turbo": "^2.8.20",
        "typescript": "^5.9.3",
        "wait-on": "^9.0.4"
    },
    "engines": {
        "node": ">=18",
        "pnpm": ">=8"
    }
}
