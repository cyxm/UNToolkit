generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model databases {
  id          Int     @id @default(autoincrement())
  version     Int?
  create_time Float?
  update_time Float?
  enable      Int?
  name        String?
}

model fields {
  id             Int     @id @default(autoincrement())
  create_time    Float?
  update_time    Float?
  enable         Int?
  name           String?
  table_id       Int?
  type           String
  primary        Int?
  auto_increment Int?
  not_null       Int?
  unique         Int?
  default        String?
  is_index       Int?
  ex_foreign     Int?
}

model tables {
  id          Int     @id @default(autoincrement())
  version     Int?
  create_time Float?
  update_time Float?
  enable      Int?
  name        String?
  database_id Int?
}
