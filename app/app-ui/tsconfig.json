{
    "compilerOptions": {
        "target": "es6",
        "module": "ES6",
        "moduleResolution": "node",
        "jsx": "react",
        "sourceMap": true,
        "noImplicitAny": true,
        "removeComments": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        }
    },
    "include": [
        ".",
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}